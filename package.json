{
	"packageManager": "pnpm@10.33.3",
	"scripts": {
		"dev": "npm run build -- --sourcemap=inline --watch",
		"build": "esbuild js/widget.ts --minify --format=esm --bundle --outdir=src/pyobservablejs/static",
		"format": "oxfmt -c oxfmtrc.jsonc \"js/**/*.ts\"",
		"format:check": "oxfmt --check -c oxfmtrc.jsonc \"js/**/*.ts\"",
		"lint": "oxlint -c oxlintrc.json --deny-warnings --report-unused-disable-directives js",
		"test:js": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@observablehq/notebook-kit": "1.7.11",
		"@shikijs/core": "4.1.0",
		"@shikijs/engine-javascript": "4.1.0",
		"@shikijs/langs": "4.1.0",
		"@shikijs/themes": "4.1.0",
		"@shikijs/types": "4.1.0"
	},
	"devDependencies": {
		"@anywidget/types": "^0.4.0",
		"esbuild": "^0.28.0",
		"jsdom": "29.1.1",
		"oxfmt": "^0.51.0",
		"oxlint": "^1.66.0",
		"typescript": "^6.0.2",
		"vitest": "4.1.7"
	}
}
