{
	"scripts": {
		"dev": "pnpm run build -- --sourcemap=inline --watch",
		"build": "esbuild js/widget/index.ts --entry-names=widget --asset-names=widget --minify --format=esm --bundle --outdir=src/pyobservablejs/static",
		"format": "oxfmt -c oxfmtrc.jsonc \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,md,mdx,yml,yaml,toml,ipynb}\"",
		"format:check": "oxfmt --check -c oxfmtrc.jsonc \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,md,mdx,yml,yaml,toml,ipynb}\"",
		"lint": "oxlint -c oxlintrc.json --deny-warnings --report-unused-disable-directives js",
		"test:js": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@observablehq/notebook-kit": "1.7.11",
		"@shikijs/core": "4.1.0",
		"@shikijs/engine-javascript": "4.1.0",
		"@shikijs/langs": "4.1.0",
		"@shikijs/themes": "4.1.0",
		"@shikijs/types": "4.1.0"
	},
	"devDependencies": {
		"@anywidget/types": "^0.4.0",
		"esbuild": "^0.28.0",
		"jsdom": "29.1.1",
		"oxfmt": "^0.51.0",
		"oxlint": "^1.66.0",
		"typescript": "^6.0.2",
		"vitest": "4.1.7"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.0.0",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215"
}
