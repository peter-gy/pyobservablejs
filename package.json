{
	"scripts": {
		"dev": "vite --config vite.config.ts",
		"build": "vite build --config vite.config.ts",
		"format": "oxfmt -c oxfmtrc.jsonc \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,md,mdx,yml,yaml,toml,ipynb}\"",
		"format:check": "oxfmt --check -c oxfmtrc.jsonc \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,md,mdx,yml,yaml,toml,ipynb}\"",
		"lint": "oxlint -c oxlintrc.json --deny-warnings --report-unused-disable-directives js",
		"test:js": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@observablehq/notebook-kit": "^2.1.8",
		"@shikijs/core": "^4.3.0",
		"@shikijs/engine-javascript": "^4.3.0",
		"@shikijs/langs": "^4.3.0",
		"@shikijs/themes": "^4.3.0",
		"@shikijs/types": "^4.3.0"
	},
	"devDependencies": {
		"@anywidget/types": "^0.4.0",
		"@anywidget/vite": "0.3.0",
		"jsdom": "29.1.1",
		"oxfmt": "^0.51.0",
		"oxlint": "^1.72.0",
		"typescript": "^6.0.3",
		"vite": "^8.1.2",
		"vitest": "4.1.7"
	},
	"packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
