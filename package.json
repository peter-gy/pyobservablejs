{
	"scripts": {
		"dev": "pnpm run build -- --watch --sourcemap inline",
		"build": "vite build --config vite.config.ts",
		"format": "oxfmt -c oxfmtrc.jsonc \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,md,mdx,yml,yaml,toml,ipynb}\"",
		"format:check": "oxfmt --check -c oxfmtrc.jsonc \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,md,mdx,yml,yaml,toml,ipynb}\"",
		"lint": "oxlint -c oxlintrc.json --deny-warnings --report-unused-disable-directives js",
		"test:js": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@observablehq/notebook-kit": "1.7.11",
		"@shikijs/core": "4.1.0",
		"@shikijs/engine-javascript": "4.1.0",
		"@shikijs/langs": "4.1.0",
		"@shikijs/themes": "4.1.0",
		"@shikijs/types": "4.1.0"
	},
	"devDependencies": {
		"@anywidget/types": "^0.4.0",
		"jsdom": "29.1.1",
		"oxfmt": "^0.51.0",
		"oxlint": "^1.68.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "4.1.7"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.16.0",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916"
}
