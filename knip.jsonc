{
	"$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
	// The root docs-build task runs the Docusaurus binary installed by apps/docs.
	"ignoreBinaries": ["docusaurus"],
	"workspaces": {
		".": {
			// The Rust engine crate embeds the isolate bootstrap with include_str!.
			"entry": ["crates/pyobservablejs-engine/src/bootstrap.js"],
		},
		"apps/docs": {
			// Docusaurus discovers MDX pages and theme overrides by directory.
			"entry": ["src/pages/**/*.mdx", "src/theme/**/*.{js,jsx,ts,tsx}"],
		},
		"apps/e2e": {
			"vite": { "config": "standalone/vite.config.ts" },
		},
		"packages/pyobservablejs": {
			// anywidget-bundle resolves its app option as the browser entry point.
			"ignoreDependencies": ["@pyobservablejs/widget"],
		},
		"packages/engine": {
			// The V8 bundle resolves Node built-ins to these shims through Vite aliases.
			"entry": ["src/node/*.ts"],
			"vite": { "config": ["vite.config.ts", "vite.browser.config.ts"] },
		},
		"packages/runtime": {
			// Observable require resolves this test fixture through its CDN loader.
			"ignoreDependencies": ["d3-format"],
		},
	},
}
